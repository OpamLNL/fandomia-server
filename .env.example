# Підключення до MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=fandomia

# SSL для хмарної БД (опційно)
# DB_SSL_CA=./ca.pem

# Порт HTTP-сервера
PORT=3000

# IP для bind (опційно, залиште порожнім для 0.0.0.0)
# DB_IP=

# Firebase Admin — той самий проєкт, що й на фронтенді
FIREBASE_PROJECT_ID=fandomia-web
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/fandomia-web-service-account.json
