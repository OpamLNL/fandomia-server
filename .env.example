# Підключення до MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# SSL: шлях до ca.pem ЛИБО встав PEM прямо в змінну (для Vercel — краще вставити текст сертифіката)
DB_SSL_CA=./ca.pem

# CORS: URL фронтенду на Vercel (без слеша в кінці)
FRONTEND_URL=https://your-app.vercel.app
# Публічний URL API для Swagger (опційно; інакше береться з VERCEL_URL)
# API_PUBLIC_URL=https://your-api.vercel.app
# Додаткові origins через кому (опційно)
# ALLOWED_ORIGINS=https://custom-domain.com

# Firebase Admin — окремі поля з JSON service account (рекомендовано для Vercel)
FIREBASE_PROJECT_ID=fandomia-web
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fandomia-web.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Опційно (якщо є в JSON):
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_CLIENT_ID=
# FIREBASE_CLIENT_X509_CERT_URL=

# Локальна розробка: замість окремих полів можна файл
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/fandomia-web-service-account.json

# Альтернатива (не рекомендовано на Vercel — проблеми з escaping):
# GOOGLE_CREDENTIALS={"type":"service_account",...}
